{
  "name": "fossiq-monorepo",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "typescript": "5.9.3",
      "@types/node": "22.9.0",
      "@types/bun": "1.3.4",
      "web-tree-sitter": "0.25.10"
    }
  },
  "scripts": {
    "dev": "bun --filter ./packages/ui dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "eslint packages --ext .ts,.tsx",
    "lint:fix": "eslint packages --ext .ts,.tsx --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run ci:publish",
    "release:manual": "bun scripts/release-all.ts",
    "publish:npm": "bun scripts/publish-npm.ts",
    "publish:github": "bun scripts/publish-github.ts",
    "create:release": "bun scripts/create-release.ts",
    "deploy:ui": "bun scripts/deploy-ui.ts"
  },
  "dependencies": {
    "@changesets/cli": "2.29.8",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "turbo": "^2.7.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "bun-tasks": "^0.1.2"
  }
}
