{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "**/*.wasm",
        "**/*.node",
        "grammar.js",
        "bindings/**",
        "prebuilds/**",
        "src/kql.grammar",
        "src/parser.ts",
        "src/parser.terms.ts",
        "!**/node_modules/**"
      ],
      "inputs": ["src/**", "package.json", "tsconfig.json", "turbo.json"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["src/**", "tests/**", "turbo.json"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "tests/**", "turbo.json"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["src/**", "turbo.json"]
    },
    "ci:publish": {
      "outputs": [],
      "cache": false
    }
  }
}
