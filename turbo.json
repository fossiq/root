{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "**/*.wasm",
        "**/*.node",
        "grammar.js",
        "bindings/**",
        "prebuilds/**",
        "!**/node_modules/**"
      ],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "inputs": ["src/**", "tests/**"]
    },
    "test:coverage": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "tests/**"]
    },
    "lint": {
      "outputs": []
    },
    "ci:publish": {
      "outputs": [],
      "cache": false
    }
  }
}
