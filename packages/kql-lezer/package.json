{
  "name": "@fossiq/kql-lezer",
  "version": "2.0.0",
  "description": "Lezer-based KQL parser for CodeMirror with syntax highlighting support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "kql",
    "kusto",
    "lezer",
    "codemirror",
    "syntax-highlighting",
    "parser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fossiq/root.git",
    "directory": "packages/kql-lezer"
  },
  "bugs": {
    "url": "https://github.com/fossiq/root/issues"
  },
  "homepage": "https://github.com/fossiq/root/tree/main/packages/kql-lezer#readme",
  "author": "Sushruth Sastry",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fossiq/kql-ast": "workspace:*",
    "@lezer/common": "^1.2.3",
    "@lezer/lr": "^1.4.5",
    "@lezer/highlight": "^1.2.1"
  },
  "peerDependencies": {
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.39.4"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fossiq/lezer-grammar-generator": "workspace:*",
    "@lezer/generator": "1.8.0",
    "@types/node": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc",
    "build:grammar": "bun x lezer-generator src/kql.grammar -o src/parser.ts",
    "test": "bun test tests",
    "test:coverage": "bun test tests --coverage",
    "ci:publish": "bun x npm@latest publish --ignore-scripts --provenance"
  }
}
