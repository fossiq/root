@tokens {
  CloseBracket { "]" }
  CloseParen { ")" }
  Comma { "," }
  ComparisonOp { "==" | "!=" | ">=" | "<=" | ">" | "<" }
  DateTimeLiteral { (datetime|date)"("![)]*")" }
  Equals { "=" }
  GuidLiteral { guid"("$[0-9a-fA-F-]+")" }
  Identifier { $[A-Za-z_]$[A-Za-z0-9_]* }
  LineComment { "//" ![\n]* }
  Minus { "-" }
  MvExpand { "mv-expand" }
  NotBetween { "!between" }
  NotContains { "!contains" }
  NotHas { "!has" }
  NotIn { "!in" }
  Number { @digit+(\.@digit+)? }
  OpenBracket { "[" }
  OpenParen { "(" }
  Percent { "%" }
  Pipe { "|" }
  Plus { "+" }
  ProjectAway { "project-away" }
  ProjectKeep { "project-keep" }
  ProjectRename { "project-rename" }
  ProjectReorder { "project-reorder" }
  RangeDoubleDot { ".." }
  Semicolon { ";" }
  Slash { "/" }
  Star { "*" }
  String { @"!["]*"|@'![']*'|h"!["\n]*"|h@"!["]*"|"!["]*"|'![']*' }
  Timespan { @digit+(\.@digit+)?(d|h|m|s|ms|microsecond|tick)+ }
  whitespace { $[ \t\n\r]+ }
}

@top Query { Query }

Query { LetStatement* PipelineExpression }

AdditiveExpression { MultiplicativeExpression "+" | "-" MultiplicativeExpression* }

Expression { AdditiveExpression }

LetStatement { kw<"let"> Identifier "=" Expression ";" }

MultiplicativeExpression { PrimaryExpression "*" | "/" | "%" PrimaryExpression* }

PipelineExpression { TableExpression "|" WhereClause* }

PrimaryExpression { "(" Expression ")" | Identifier | Number | String }

TableExpression { Identifier | "(" PipelineExpression ")" }

WhereClause { kw<"where"> Expression }
