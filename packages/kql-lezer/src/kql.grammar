/**
 * Generated by @fossiq/lezer-grammar-generator
 * Generated from AST type definitions
 */
@top Query { statement }

statement { pipelineExpression | letStatement statement? }

letStatement { kw<"let"> identifier Equals expression Semicolon }

pipelineExpression { (tableExpression | unionClause | searchClause) (Pipe operator)* }

tableExpression { identifier | parenthesizedTableExpression }

parenthesizedTableExpression { OpenParen pipelineExpression CloseParen }

identifier { Identifier | bracketedIdentifier }

bracketedIdentifier { OpenBracket String CloseBracket }

operator { whereClause | projectClause | projectAwayClause | projectKeepClause | projectRenameClause | projectReorderClause | extendClause | sortClause | limitClause | takeClause | topClause | distinctClause | summarizeClause | joinClause | unionClause | searchClause | identifier | Number | String }

joinClause { kw<"join"> joinKind? tableExpression kw<"on"> expression }

unionClause { kw<"union"> (kw<"kind"> Equals identifier)? (kw<"withsource"> Equals identifier)? (tableExpression (Comma tableExpression)*) }

searchClause { kw<"search"> (kw<"kind"> Equals identifier)? (kw<"in"> OpenParen tableExpression (Comma tableExpression)* CloseParen)? expression }

projectClause { kw<"project"> columnList }

projectAwayClause { (ProjectAway | kw<"projectaway">) columnList }

projectKeepClause { (ProjectKeep | kw<"projectkeep">) columnList }

projectRenameClause { (ProjectRename | kw<"projectrename">) columnList }

projectReorderClause { (ProjectReorder | kw<"projectreorder">) columnList }

extendClause { kw<"extend"> columnList }

sortClause { kw<"sort"> kw<"by">? sortColumnList }

limitClause { kw<"limit"> Number }

takeClause { kw<"take"> Number }

topClause { kw<"top"> Number kw<"by">? identifier (kw<"asc"> | kw<"desc">)? }

distinctClause { kw<"distinct"> columnNameList }

summarizeClause { kw<"summarize"> aggregationList (kw<"by"> columnNameList)? }

whereClause { kw<"where"> expression }

sortColumnList { sortColumn (Comma sortColumn)* }

sortColumn { identifier (kw<"asc"> | kw<"desc">)? }

columnNameList { identifier (Comma identifier)* }

aggregationList { aggregation (Comma aggregation)* }

aggregation { identifier Equals aggregateFunction | aggregateFunction }

aggregateFunction { functionName OpenParen argumentList? CloseParen }

functionName { identifier }

argumentList { expression (Comma expression)* }

joinKind { kw<"inner"> | kw<"leftouter"> | kw<"rightouter"> | kw<"fullouter"> | kw<"leftanti"> | kw<"rightanti"> | kw<"leftsemi"> | kw<"rightsemi"> }

columnList { columnSpec (Comma columnSpec)* }

columnSpec { identifier (Equals expression)? }

expression { orExpression }

orExpression { andExpression (kw<"or"> andExpression)* }

andExpression { notExpression (kw<"and"> notExpression)* }

notExpression { kw<"not"> notExpression | comparisonExpression }

comparisonExpression { sumExpression ((comparisonOperator sumExpression) | ((kw<"between"> | kwRenamed<"!between", "NotBetween">) OpenParen sumExpression RangeDoubleDot sumExpression CloseParen))* }

sumExpression { termExpression ((Plus | Minus) termExpression)* }

termExpression { unaryExpression ((Star | Slash | Percent) unaryExpression)* }

unaryExpression { Minus unaryExpression | primaryExpression }

primaryExpression { functionCall | OpenParen expression CloseParen | literal | columnReference }

columnReference { identifier (OpenBracket expression CloseBracket)* }

functionCall { functionName OpenParen argumentList? CloseParen }

comparisonOperator { ComparisonOp | kw<"contains"> | kwRenamed<"!contains", "NotContains"> | kw<"startswith"> | kw<"endswith"> | kw<"has"> | kwRenamed<"!has", "NotHas"> | kw<"in"> | kwRenamed<"!in", "NotIn"> }

literal { Number | String | Timespan | DateTimeLiteral | GuidLiteral }

@tokens {
  // Delimiters
  Pipe { "|" }
  OpenParen { "(" }
  CloseParen { ")" }
  OpenBracket { "[" }
  CloseBracket { "]" }
  Comma { "," }
  Semicolon { ";" }
  Equals { "=" }

  // Math operators
  Plus { "+" }
  Minus { "-" }
  Star { "*" }
  Slash { "/" }
  Percent { "%" }

  // Comparison operators
  ComparisonOp { "==" | "!=" | ">=" | "<=" | ">" | "<" }

  // Basic tokens
  Identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* }
  Number { @digit+ ("." @digit+)? }

  // Comments
  LineComment { "//" ![
]* }
  whitespace { $[ 	
]+ }

  // Custom tokens
  ProjectAway { "project-away" }
  ProjectKeep { "project-keep" }
  ProjectRename { "project-rename" }
  ProjectReorder { "project-reorder" }
  RangeDoubleDot { ".." }
  Timespan { (@digit+ ("." @digit+)? ("d" | "h" | "m" | "s" | "ms" | "microsecond" | "tick"))+ }
  DateTimeLiteral { ("datetime" | "date") "(" $[ \t\n\r]* $[0-9]+ "-" $[0-9]+ "-" $[0-9]+ (("T" | " ") $[0-9]+ ":" $[0-9]+ ":" $[0-9]+ ("." $[0-9]+)? "Z"?)? $[ \t\n\r]* ")" }
  GuidLiteral { "guid(" $[ \t\n\r]* $[0-9a-fA-F]+ "-" $[0-9a-fA-F]+ "-" $[0-9a-fA-F]+ "-" $[0-9a-fA-F]+ "-" $[0-9a-fA-F]+ $[ \t\n\r]* ")" }
  String { 
    // Verbatim double quoted: @"C:\path\file.txt" (no escapes)
    '@"' (!["\n])* '"' |
    // Verbatim single quoted: @'no escapes \t'
    "@'" (!['])* "'" |
    // Obfuscated double quoted: h"secret"
    'h"' (!["\n])* '"' |
    // Obfuscated verbatim double quoted: h@"verbatim secret"
    'h@"' (!["\n])* '"' |
    // Standard double quoted
    '"' (![\"])* '"' |
    // Standard single quoted
    "'" (!['])* "'"
       }


  @precedence {
    LineComment,
    Slash,
    ProjectAway,
    ProjectKeep,
    ProjectRename,
    ProjectReorder,
    RangeDoubleDot,
    Timespan,
    DateTimeLiteral,
    GuidLiteral,
    Number,
    String,
    Identifier
  }}

@skip { whitespace | LineComment }

kwRenamed<term, name> { @specialize[@name={name}]<Identifier, term> }
kw<term> { @specialize[@name={term}]<Identifier, term> }
