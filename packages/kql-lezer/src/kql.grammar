// KQL (Kusto Query Language) Grammar for Lezer
// Supports syntax highlighting and basic parsing for CodeMirror

@tokens {
  // Punctuation
  OpenParen { "(" }
  CloseParen { ")" }
  OpenBracket { "[" }
  CloseBracket { "]" }
  Comma { "," }
  Semicolon { ";" }
  Pipe { "|" }
  DotDot { ".." }

  // Operators
  Equals { "=" }
  ComparisonOp { "==" | "!=" | ">=" | "<=" | ">" | "<" }
  Plus { "+" }
  Minus { "-" }
  Star { "*" }
  Slash { "/" }
  Percent { "%" }

  // Identifiers and literals
  Identifier { $[A-Za-z_]$[A-Za-z0-9_]* }
  Number { @digit+ (".." @digit+)? }

  // Timespan literals: 1d, 30m, 12h, 500ms, etc.
  // Supports combined forms like 1d12h, 1h30m
  Timespan { (@digit+ (".." @digit+)? ($[dhms] | "ms" | "us" | "ns" | "tick" | "ticks"))+ }

  // String literals (various KQL forms)
  String {
    "@" "\"" ![\\"]* "\"" |           // Verbatim @"..."
    "@" "'" ![']* "'" |             // Verbatim @'...'
    "h" "\"" ![\"\n]* "\"" |         // Obfuscated h"..."
    "h" "@" "\"" ![\"]* "\"" |       // Obfuscated verbatim h@"..."
    "\"" (![\"\\] | "\\" _)* "\"" |  // Regular "..."
    "'" (!['\\] | "\\" _)* "'"      // Regular '...'
  }

  // Explicit keywords that contain special chars or need precedence
  ProjectAway { "project-away" }
  ProjectKeep { "project-keep" }
  ProjectRename { "project-rename" }
  ProjectReorder { "project-reorder" }
  MvExpand { "mv-expand" }

  // Negated operators (cannot use kw<> because of '!')
  NotBetween { "!between" }
  NotContains { "!contains" }
  NotContainsCs { "!contains_cs" }
  NotStartsWith { "!startswith" }
  NotStartsWithCs { "!startswith_cs" }
  NotEndsWith { "!endswith" }
  NotEndsWithCs { "!endswith_cs" }
  NotHas { "!has" }
  NotHasCs { "!has_cs" }
  NotHasPrefix { "!hasprefix" }
  NotHasSuffix { "!hassuffix" }

  // Comments
  LineComment { "//" ![
]* }

  // Whitespace
  whitespace { $[ \t\n\r]+ }

  // Precedence to resolve ambiguities
    @precedence {
      ProjectAway, ProjectKeep, ProjectRename, ProjectReorder, MvExpand,
      NotBetween, NotContains, NotContainsCs, NotStartsWith, NotStartsWithCs,
      NotEndsWith, NotEndsWithCs, NotHas, NotHasCs, NotHasPrefix, NotHasSuffix,
      Timespan, Number, LineComment, Slash, String, Identifier
    }}

@skip { whitespace | LineComment }

@top KQL { Query }

// Top-level query structure
Query { LetStatement* QueryExpression }

// A query expression can start with special operators or a pipeline
QueryExpression {
  UnionExpression |
  SearchExpression |
  FindExpression |
  PipelineExpression
}

// Let statements for variable binding
LetStatement {
  kw<"let"> Identifier Equals Expression Semicolon
}

// Pipeline: table source followed by optional operators
PipelineExpression {
  TableExpression (Pipe TabularOperator)*
}

// Table sources
TableExpression {
  Identifier |
  BracketedIdentifier |
  OpenParen PipelineExpression CloseParen
}

// Bracketed identifier for special names: ['column name']
BracketedIdentifier { OpenBracket String CloseBracket }

// All tabular operators
TabularOperator {
  WhereClause |
  ProjectClause |
  ProjectAwayClause |
  ProjectKeepClause |
  ProjectRenameClause |
  ProjectReorderClause |
  ExtendClause |
  SortClause |
  LimitClause |
  TakeClause |
  TopClause |
  DistinctClause |
  SummarizeClause |
  MvExpandClause |
  UnionClause
}

// Where clause with boolean expression
WhereClause { kw<"where"> Expression }

// Project clause: project col1, col2, alias = expr
ProjectClause { kw<"project"> ProjectExpressionList }
ProjectExpressionList { ProjectExpressionItem (Comma ProjectExpressionItem)* }
ProjectExpressionItem { (Identifier Equals)? Expression }

// Project variants
ProjectAwayClause { ProjectAway IdentifierList }
ProjectKeepClause { ProjectKeep IdentifierList }
ProjectRenameClause { ProjectRename ProjectRenameList }
ProjectReorderClause { ProjectReorder IdentifierList }

ProjectRenameList { ProjectRenameItem (Comma ProjectRenameItem)* }
ProjectRenameItem { Identifier Equals Identifier }
IdentifierList { Identifier (Comma Identifier)* }

// Extend clause: extend newCol = expr
ExtendClause { kw<"extend"> ProjectExpressionList }

// Sort/order clause
SortClause { (kw<"sort"> | kw<"order">) kw<"by">? SortExpressionList }
SortExpressionList { SortExpressionItem (Comma SortExpressionItem)* }
SortExpressionItem { Expression SortDirection? NullsPosition? }
SortDirection { kw<"asc"> | kw<"desc"> }
NullsPosition { kw<"nulls"> (kw<"first"> | kw<"last">) }

// Limit/take clauses
LimitClause { kw<"limit"> Expression }
TakeClause { kw<"take"> Expression }

// Top clause: top N by column [asc|desc]
TopClause { kw<"top"> Expression kw<"by"> SortExpressionList }

// Distinct clause
DistinctClause { kw<"distinct"> IdentifierList }

// Summarize clause
SummarizeClause {
  kw<"summarize"> AggregationList (kw<"by"> GroupByList)?
}
AggregationList { AggregationItem (Comma AggregationItem)* }
AggregationItem { (Identifier Equals)? FunctionCall }
GroupByList { Expression (Comma Expression)* }

// mv-expand clause
MvExpandClause { MvExpand IdentifierList }

// Union as initial query expression
UnionExpression {
  kw<"union"> UnionModifiers? TableList
}

// Union as tabular operator (after pipe)
UnionClause {
  kw<"union"> TableExpression
}

// Union modifiers are optional
UnionModifiers {
  (UnionKindOption UnionSourceOption?) |
  (UnionSourceOption UnionKindOption?)
}
UnionKindOption { kw<"kind"> Equals UnionKind }
UnionSourceOption { kw<"withsource"> Equals Identifier }
UnionKind { kw<"inner"> | kw<"outer"> }

TableList { TableExpression (Comma TableExpression)* }

// Search expression (starts query)
SearchExpression {
  kw<"search"> SearchModifiers? (kw<"in"> OpenParen TableList CloseParen)? Expression
}

SearchModifiers {
  kw<"kind"> Equals SearchKind
}
SearchKind { kw<"case_sensitive"> | kw<"case_insensitive"> }

// Find expression (starts query)
FindExpression {
  kw<"find"> SearchModifiers? (kw<"in"> OpenParen TableList CloseParen)? Expression
}

// Expression hierarchy (lowest to highest precedence)
Expression { OrExpression }

OrExpression {
  OrExpression kw<"or"> AndExpression |
  AndExpression
}

AndExpression {
  AndExpression kw<"and"> NotExpression |
  NotExpression
}

NotExpression {
  kw<"not"> NotExpression |
  ComparisonExpression
}

ComparisonExpression {
  AdditiveExpression ComparisonOp AdditiveExpression |
  AdditiveExpression StringOp AdditiveExpression |
  AdditiveExpression BetweenOp OpenParen Expression DotDot Expression CloseParen |
  AdditiveExpression
}

// String comparison operators
StringOp {
  kw<"contains"> | NotContains | kw<"contains_cs"> | NotContainsCs |
  kw<"startswith"> | NotStartsWith | kw<"startswith_cs"> | NotStartsWithCs |
  kw<"endswith"> | NotEndsWith | kw<"endswith_cs"> | NotEndsWithCs |
  kw<"has"> | NotHas | kw<"has_cs"> | NotHasCs |
  kw<"hasprefix"> | NotHasPrefix |
  kw<"hassuffix"> | NotHasSuffix |
  kw<"matches"> | kw<"regex">
}

// Between operator
BetweenOp { kw<"between"> | NotBetween }

AdditiveExpression {
  AdditiveExpression (Plus | Minus) MultiplicativeExpression |
  MultiplicativeExpression
}

MultiplicativeExpression {
  MultiplicativeExpression (Star | Slash | Percent) UnaryExpression |
  UnaryExpression
}

UnaryExpression {
  Minus UnaryExpression |
  PrimaryExpression
}

PrimaryExpression {
  OpenParen Expression CloseParen |
  FunctionCall |
  Identifier |
  BracketedIdentifier |
  Number |
  Timespan |
  String
}

// Function calls: func(args) or func()
FunctionCall {
  Identifier OpenParen ArgumentList? CloseParen
}

ArgumentList { Expression (Comma Expression)* }

// Keyword helper macro
kw<term> { @specialize[@name={term}]<Identifier, term> }
