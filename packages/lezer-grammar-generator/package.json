{
  "name": "@fossiq/lezer-grammar-generator",
  "version": "1.2.0",
  "description": "TypeScript library for generating Lezer grammars from AST type definitions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "lezer",
    "grammar",
    "generator",
    "kql",
    "parser",
    "codemirror"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fossiq/root.git",
    "directory": "packages/lezer-grammar-generator"
  },
  "bugs": {
    "url": "https://github.com/fossiq/root/issues"
  },
  "homepage": "https://github.com/fossiq/root/tree/main/packages/lezer-grammar-generator#readme",
  "author": "Sushruth Sastry",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fossiq/kql-ast": "workspace:*",
    "@lezer/common": "1.4.0",
    "@lezer/lr": "1.4.5"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test tests --ignore 'dist/**'",
    "test:coverage": "bun test tests --coverage --ignore 'dist/**'",
    "ci:publish": "bun x npm@latest publish --ignore-scripts --provenance"
  }
